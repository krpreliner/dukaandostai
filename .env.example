# DukaanDost AI - Environment Configuration Example

APP_NAME="DukaanDost AI"
TAGLINE="Your AI Business Partner That Doesn't Just Advise. It Takes Action."
STORE_NAME="Sharma General Store"
STORE_LOCATION="Ranchi, Jharkhand, India"
STORE_OWNER="Sharma Ji"

# Financial Baseline & Target
INITIAL_NET_INCOME=8000.0
TARGET_NET_INCOME=10000.0
MAX_PROMOTIONAL_DISCOUNT_PCT=15.0

# Database & Checkpoint Persistence
DATABASE_URL="sqlite:///./dukaandost.db"
CHECKPOINT_DB_PATH="./checkpoints.db"

# AI Mode (Default: 100% Deterministic Local Mode - No API key required!)
USE_LOCAL_DETERMINISTIC_MODE=True
OPENAI_API_KEY=""

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
