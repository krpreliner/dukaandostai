# ==============================================================================
# DUKAANDOST AI - REAL API KEYS & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Active AI Mode: deterministic | gemini | openai | groq | ollama
AI_MODE=deterministic

# ------------------------------------------------------------------------------
# 1. REAL AI / LLM PROVIDER API KEYS
# ------------------------------------------------------------------------------
# Google Gemini (Free API Key available at: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq Cloud (Ultra-fast inference at: https://console.groq.com/keys)
GROQ_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Local Ollama URL (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 2. REAL METEOROLOGICAL & LOCATION WEATHER API
# ------------------------------------------------------------------------------
# OpenWeatherMap (Free API key at: https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# ------------------------------------------------------------------------------
# 3. REAL SMS & WHATSAPP DISPATCH (TWILIO)
# ------------------------------------------------------------------------------
# Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 4. SECURITY & DATABASE
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
JWT_SECRET_KEY=dukaandost_kirana_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./dukaandost.db
CHECKPOINT_DB_PATH=./checkpoints.db
